# Required: secret key for Flask sessions.
# Generate with:  openssl rand -hex 32
SEARXNG_SECRET=

# Brave Search API key (subscription token).
# Request one at https://api-dashboard.search.brave.com/.
# Patched into /etc/loogi/settings.yml -> engines.braveapi.api_key at
# build time (see Dockerfile + ADR 0016). Leave empty = engine disabled.
# IMPORTANT: after setting, run "docker compose build" + "docker compose up -d"
# so the key lands in the image.
BRAVE_API_KEY=

# Optional overrides (defaults live in compose.yml and settings.yml):
# SEARXNG_BASE_URL=https://loogi.ch/
# INSTANCE_NAME=LOOGI
