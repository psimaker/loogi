# Pflicht: Secret Key fuer Flask-Sessions.
# Generieren mit:  openssl rand -hex 32
SEARXNG_SECRET=

# Brave Search API-Key (Subscription-Token).
# Anfordern unter https://api-dashboard.search.brave.com/.
# Wird zur Build-Zeit in /etc/searxng/settings.yml -> engines.braveapi.api_key
# gepatched (siehe Dockerfile + ADR 0016). Leer lassen = Engine deaktiviert.
# WICHTIG: nach dem Setzen "docker compose build" + "docker compose up -d",
# damit der Key im Image ankommt.
BRAVE_API_KEY=

# Optional ueberschreibbar (Defaults stehen in compose.yml und settings.yml):
# SEARXNG_BASE_URL=https://loogi.ch/
# INSTANCE_NAME=LOOGI
